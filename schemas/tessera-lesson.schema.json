{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessera:schema:lesson:1",
  "title": "Tessera lesson file (lessons/<id>.json), format version 1",
  "type": "object",
  "required": ["format", "formatVersion", "id", "title", "kind", "blocks"],
  "properties": {
    "format": { "const": "tessera-lesson" },
    "formatVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^lsn_[A-Za-z0-9_-]{4,64}$" },
    "title": { "type": "string" },
    "kind": { "enum": ["lesson", "assessment", "section"] },
    "description": { "type": "string" },
    "assessment": {
      "type": "object",
      "properties": {
        "passThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "attempts": { "type": "integer", "minimum": 0, "description": "0 means unlimited" },
        "shuffleQuestions": { "type": "boolean" },
        "shuffleChoices": { "type": "boolean" },
        "feedback": { "enum": ["after-each", "at-end", "none"] },
        "revealAnswers": { "type": "boolean" },
        "requiredForCompletion": { "type": "boolean" }
      }
    },
    "source": { "$ref": "#/$defs/binding" },
    "origin": { "type": "object" },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "description": "Link to a preserved import",
      "properties": {
        "adapter": { "enum": ["rise", "html"] },
        "ref": { "type": "string" },
        "editable": { "type": "array", "items": { "type": "string" } },
        "fixed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
    "block": {
      "type": "object",
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^blk_[A-Za-z0-9_-]{4,64}$" },
        "type": { "type": "string", "description": "Registered block type; see docs/BLOCK_INTERFACE.md" },
        "v": { "type": "integer", "minimum": 1, "description": "Block schema version" },
        "content": { "type": "object" },
        "settings": { "type": "object" },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "enum": ["content", "wide", "full"] },
            "align": { "enum": ["left", "center"] },
            "background": { "$ref": "#/$defs/color" },
            "textColor": { "$ref": "#/$defs/color" },
            "paddingTop": { "type": "number", "minimum": 0, "maximum": 400 },
            "paddingBottom": { "type": "number", "minimum": 0, "maximum": 400 },
            "radius": { "type": "number", "minimum": 0, "maximum": 64 }
          }
        },
        "source": { "$ref": "#/$defs/binding" },
        "origin": { "type": "object" }
      }
    }
  }
}
