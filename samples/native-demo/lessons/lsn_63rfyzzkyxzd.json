          },
          {
            "id": "itm_d4e5f6",
            "html": "Identification numbers"
          },
          {
            "id": "itm_g7h8i9",
            "html": "Location data and online identifiers"
          }
        ]
      },
      "settings": {},
      "overrides": {}
