{
  "name": "tessera-editor",
  "productName": "Tessera",
  "version": "0.1.0",
  "description": "Open-source desktop editor for block-based, responsive learning content. Your content, your files, your output.",
  "license": "Apache-2.0",
  "author": "Tessera contributors",
  "type": "module",
  "main": "src/desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:runtime": "vite build --config vite.runtime.config.js",
    "build:editor": "vite build --config vite.editor.config.js",
    "build": "npm run build:runtime && npm run build:editor",
    "start": "npm run build && electron .",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "licenses": "node scripts/check-licenses.mjs",
    "samples": "node scripts/make-samples.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "dependencies": {
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
